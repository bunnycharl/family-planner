# Database (SQLite file path)
DATABASE_URL="file:./prod.db"

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET="your-secret-here"

# Production URL (your domain)
AUTH_URL="https://your-domain.com"
AUTH_TRUST_HOST=true

# Seed users (used by: npx prisma db seed)
SEED_USER1_EMAIL="user1"
SEED_USER1_NAME="User 1"
SEED_USER1_PASSWORD="your-pin-here"

SEED_USER2_EMAIL="user2"
SEED_USER2_NAME="User 2"
SEED_USER2_PASSWORD="your-pin-here"
