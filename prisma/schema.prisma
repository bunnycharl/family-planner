generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String
  avatarColor    String   @default("#6366f1")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdEvents     Event[]     @relation("EventCreator")
  modifiedEvents    Event[]     @relation("EventModifier")
  assignedEvents    Event[]     @relation("EventAssignees")
  createdTasks      Task[]      @relation("TaskCreator")
  assignedTasks     Task[]      @relation("TaskAssignee")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String
  icon      String?
  createdAt DateTime @default(now())

  events Event[]
  tasks  Task[]
}

model Event {
  id             String    @id @default(cuid())
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime?
  location       String?
  isRecurring    Boolean   @default(false)
  recurrenceRule String?
  isCompleted    Boolean   @default(false)
  color          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  createdById  String
  createdBy    User      @relation("EventCreator", fields: [createdById], references: [id])
  modifiedById String?
  modifiedBy   User?     @relation("EventModifier", fields: [modifiedById], references: [id])
  assignees    User[]    @relation("EventAssignees")

  @@index([startDate])
  @@index([categoryId])
  @@index([createdById])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("TODO")
  priority    String    @default("MEDIUM")
  position    Int       @default(0)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdById String
  createdBy   User      @relation("TaskCreator", fields: [createdById], references: [id])
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([status])
  @@index([createdById])
  @@index([assigneeId])
}

// ─── Finances ───────────────────────────────────────────────

model FinancePerson {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incomeEntries    IncomeEntry[]
  incomeParams     IncomeParam[]
  incomeCategories FinanceIncomeCategory[]
  taxRules         FinanceTaxRule[]
}

model FinanceIncomeCategory {
  id       String        @id @default(cuid())
  personId String
  person   FinancePerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  name     String
  position Int           @default(0)

  @@unique([personId, name])
  @@index([personId])
}

model FinanceTaxRule {
  id       String        @id @default(cuid())
  personId String
  person   FinancePerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  category String
  rate     Float

  @@unique([personId, category])
  @@index([personId])
}

model IncomeEntry {
  id        String        @id @default(cuid())
  personId  String
  person    FinancePerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  category  String
  amount    Float         @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([personId, year, month, category])
  @@index([personId])
  @@index([year, month])
}

model IncomeParam {
  id        String        @id @default(cuid())
  personId  String
  person    FinancePerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  key       String
  value     Float         @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([personId, year, month, key])
  @@index([personId])
  @@index([year, month])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  eurRub    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}

model ExpenseEntry {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  group     String
  category  String
  amount    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month, group, category])
  @@index([year, month])
  @@index([group])
}

model ExpenseGroup {
  id         String                 @id @default(cuid())
  name       String
  slug       String                 @unique
  currency   String                 @default("RUB")
  position   Int                    @default(0)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  categories ExpenseGroupCategory[]

  @@index([position])
}

model ExpenseGroupCategory {
  id       String       @id @default(cuid())
  groupId  String
  group    ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name     String
  position Int          @default(0)

  @@unique([groupId, name])
  @@index([groupId])
}

// ─── Roadmap ────────────────────────────────────────────────

model RoadmapPhase {
  id        String   @id @default(cuid())
  name      String
  emoji     String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks RoadmapTask[]

  @@index([position])
}

model RoadmapTask {
  id          String       @id @default(cuid())
  name        String
  details     String?
  taskType    String
  startDate   DateTime
  endDate     DateTime
  isCompleted Boolean      @default(false)
  position    Int          @default(0)
  phaseId     String
  phase       RoadmapPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([phaseId])
  @@index([startDate])
}

model RoadmapTaskType {
  id       String @id @default(cuid())
  key      String @unique
  label    String
  color    String
  position Int    @default(0)
}

