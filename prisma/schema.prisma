generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String
  avatarColor    String   @default("#6366f1")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdEvents     Event[]     @relation("EventCreator")
  modifiedEvents    Event[]     @relation("EventModifier")
  assignedEvents    Event[]     @relation("EventAssignees")
  createdTasks      Task[]      @relation("TaskCreator")
  assignedTasks     Task[]      @relation("TaskAssignee")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String
  icon      String?
  createdAt DateTime @default(now())

  events Event[]
  tasks  Task[]
}

model Event {
  id             String    @id @default(cuid())
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime?
  location       String?
  isRecurring    Boolean   @default(false)
  recurrenceRule String?
  isCompleted    Boolean   @default(false)
  color          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  createdById  String
  createdBy    User      @relation("EventCreator", fields: [createdById], references: [id])
  modifiedById String?
  modifiedBy   User?     @relation("EventModifier", fields: [modifiedById], references: [id])
  assignees    User[]    @relation("EventAssignees")

  @@index([startDate])
  @@index([categoryId])
  @@index([createdById])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("TODO")
  priority    String    @default("MEDIUM")
  position    Int       @default(0)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdById String
  createdBy   User      @relation("TaskCreator", fields: [createdById], references: [id])
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([status])
  @@index([createdById])
  @@index([assigneeId])
}

// ─── Budget / Finances (v2) ────────────────────────────────

model BudgetYear {
  id           String   @id @default(cuid())
  year         Int      @unique
  baseCurrency String   @default("RUB")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members       FamilyMember[]
  taxRates      TaxRate[]
  expenseGroups BudgetExpenseGroup[]
  currencyRates CurrencyRate[]
}

model FamilyMember {
  id           String     @id @default(cuid())
  budgetYearId String
  budgetYear   BudgetYear @relation(fields: [budgetYearId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)

  incomeCategories BudgetIncomeCategory[]

  @@index([budgetYearId])
}

model BudgetIncomeCategory {
  id             String       @id @default(cuid())
  familyMemberId String
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  name           String
  type           String       @default("FIXED")
  taxRateId      String?
  taxRate        TaxRate?     @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  formula        String?
  sortOrder      Int          @default(0)

  params  FormulaParam[]
  entries BudgetIncomeEntry[]

  @@index([familyMemberId])
}

model FormulaParam {
  id               String               @id @default(cuid())
  incomeCategoryId String
  incomeCategory   BudgetIncomeCategory @relation(fields: [incomeCategoryId], references: [id], onDelete: Cascade)
  name             String
  paramKey         String
  sortOrder        Int                  @default(0)

  values FormulaParamValue[]

  @@unique([incomeCategoryId, paramKey])
  @@index([incomeCategoryId])
}

model BudgetIncomeEntry {
  id               String               @id @default(cuid())
  incomeCategoryId String
  incomeCategory   BudgetIncomeCategory @relation(fields: [incomeCategoryId], references: [id], onDelete: Cascade)
  month            Int
  amount           Float                @default(0)

  @@unique([incomeCategoryId, month])
  @@index([incomeCategoryId])
}

model FormulaParamValue {
  id             String       @id @default(cuid())
  formulaParamId String
  formulaParam   FormulaParam @relation(fields: [formulaParamId], references: [id], onDelete: Cascade)
  month          Int
  value          Float        @default(0)

  @@unique([formulaParamId, month])
  @@index([formulaParamId])
}

model TaxRate {
  id           String     @id @default(cuid())
  budgetYearId String
  budgetYear   BudgetYear @relation(fields: [budgetYearId], references: [id], onDelete: Cascade)
  name         String
  rate         Float
  sortOrder    Int        @default(0)

  incomeCategories BudgetIncomeCategory[]

  @@index([budgetYearId])
}

model BudgetExpenseGroup {
  id           String     @id @default(cuid())
  budgetYearId String
  budgetYear   BudgetYear @relation(fields: [budgetYearId], references: [id], onDelete: Cascade)
  name         String
  currency     String     @default("RUB")
  sortOrder    Int        @default(0)

  categories BudgetExpenseCategory[]

  @@index([budgetYearId])
}

model BudgetExpenseCategory {
  id             String             @id @default(cuid())
  expenseGroupId String
  expenseGroup   BudgetExpenseGroup @relation(fields: [expenseGroupId], references: [id], onDelete: Cascade)
  name           String
  sortOrder      Int                @default(0)

  entries BudgetExpenseEntry[]

  @@index([expenseGroupId])
}

model BudgetExpenseEntry {
  id                String                @id @default(cuid())
  expenseCategoryId String
  expenseCategory   BudgetExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)
  month             Int
  amount            Float                 @default(0)

  @@unique([expenseCategoryId, month])
  @@index([expenseCategoryId])
}

model CurrencyRate {
  id           String     @id @default(cuid())
  budgetYearId String
  budgetYear   BudgetYear @relation(fields: [budgetYearId], references: [id], onDelete: Cascade)
  currency     String
  month        Int
  rate         Float      @default(0)

  @@unique([budgetYearId, currency, month])
  @@index([budgetYearId])
}

// ─── Roadmap ────────────────────────────────────────────────

model RoadmapPhase {
  id        String   @id @default(cuid())
  name      String
  emoji     String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks RoadmapTask[]

  @@index([position])
}

model RoadmapTask {
  id          String       @id @default(cuid())
  name        String
  details     String?
  taskType    String
  startDate   DateTime
  endDate     DateTime
  isCompleted Boolean      @default(false)
  position    Int          @default(0)
  phaseId     String
  phase       RoadmapPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([phaseId])
  @@index([startDate])
}

model RoadmapTaskType {
  id       String @id @default(cuid())
  key      String @unique
  label    String
  color    String
  position Int    @default(0)
}

