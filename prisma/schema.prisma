generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String
  avatarColor    String   @default("#6366f1")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdEvents    Event[]                @relation("EventCreator")
  assignedEvents   Event[]                @relation("EventAssignee")
  createdTasks     Task[]                 @relation("TaskCreator")
  assignedTasks    Task[]                 @relation("TaskAssignee")
  incomeCategories BudgetIncomeCategory[] @relation("BudgetIncomeCategories")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String
  icon      String?
  createdAt DateTime @default(now())

  events Event[]
  tasks  Task[]
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdById String
  createdBy   User      @relation("EventCreator", fields: [createdById], references: [id])
  assigneeId  String?
  assignee    User?     @relation("EventAssignee", fields: [assigneeId], references: [id])

  @@index([date])
  @@index([categoryId])
  @@index([createdById])
  @@index([assigneeId])
}

model Task {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      String        @default("TODO")
  position    Int           @default(0)
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  createdById String
  createdBy   User          @relation("TaskCreator", fields: [createdById], references: [id])
  assigneeId  String?
  assignee    User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  showOnRoadmap Boolean       @default(false)
  phaseId     String?
  phase       RoadmapPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdById])
  @@index([assigneeId])
  @@index([phaseId])
  @@index([endDate])
}

// ─── Budget / Finances (v2) ────────────────────────────────

model BudgetYear {
  id           String   @id @default(cuid())
  year         Int      @unique
  baseCurrency String   @default("RUB")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  incomeCategories      BudgetIncomeCategory[]
  taxRates              TaxRate[]
  expenseGroups         BudgetExpenseGroup[]
  currencyRates         CurrencyRate[]
  transactionCategories TransactionCategory[]
}

model BudgetIncomeCategory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("BudgetIncomeCategories", fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("FIXED")
  taxRateId String?
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  formula   String?

  budgetYearId String
  budgetYear   BudgetYear @relation(fields: [budgetYearId], references: [id], onDelete: Cascade)

  params  FormulaParam[]
  entries BudgetIncomeEntry[]

  @@index([userId])
  @@index([budgetYearId])
}

model FormulaParam {
  id               String               @id @default(cuid())
  incomeCategoryId String
  incomeCategory   BudgetIncomeCategory @relation(fields: [incomeCategoryId], references: [id], onDelete: Cascade)
  name             String
  paramKey         String
  sortOrder        Int                  @default(0)

  values FormulaParamValue[]

  @@unique([incomeCategoryId, paramKey])
  @@index([incomeCategoryId])
}

model BudgetIncomeEntry {
  id               String               @id @default(cuid())
  incomeCategoryId String
  incomeCategory   BudgetIncomeCategory @relation(fields: [incomeCategoryId], references: [id], onDelete: Cascade)
  month            Int
  amount           Float                @default(0)

  @@unique([incomeCategoryId, month])
  @@index([incomeCategoryId])
}

model FormulaParamValue {
  id             String       @id @default(cuid())
  formulaParamId String
  formulaParam   FormulaParam @relation(fields: [formulaParamId], references: [id], onDelete: Cascade)
  month          Int
  value          Float        @default(0)

  @@unique([formulaParamId, month])
  @@index([formulaParamId])
}

model TaxRate {
  id           String     @id @default(cuid())
  budgetYearId String
  budgetYear   BudgetYear @relation(fields: [budgetYearId], references: [id], onDelete: Cascade)
  name         String
  rate         Float
  sortOrder    Int        @default(0)

  incomeCategories BudgetIncomeCategory[]

  @@index([budgetYearId])
}

model BudgetExpenseGroup {
  id           String     @id @default(cuid())
  budgetYearId String
  budgetYear   BudgetYear @relation(fields: [budgetYearId], references: [id], onDelete: Cascade)
  name         String
  currency     String     @default("RUB")
  sortOrder    Int        @default(0)

  categories BudgetExpenseCategory[]

  @@index([budgetYearId])
}

model BudgetExpenseCategory {
  id             String             @id @default(cuid())
  expenseGroupId String
  expenseGroup   BudgetExpenseGroup @relation(fields: [expenseGroupId], references: [id], onDelete: Cascade)
  name           String
  sortOrder      Int                @default(0)

  entries               BudgetExpenseEntry[]
  transactionCategories TransactionCategory[]

  @@index([expenseGroupId])
}

model BudgetExpenseEntry {
  id                String                @id @default(cuid())
  expenseCategoryId String
  expenseCategory   BudgetExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)
  month             Int
  amount            Float                 @default(0)

  @@unique([expenseCategoryId, month])
  @@index([expenseCategoryId])
}

model CurrencyRate {
  id           String     @id @default(cuid())
  budgetYearId String
  budgetYear   BudgetYear @relation(fields: [budgetYearId], references: [id], onDelete: Cascade)
  currency     String
  month        Int
  rate         Float      @default(0)

  @@unique([budgetYearId, currency, month])
  @@index([budgetYearId])
}

// ─── Transactions (fact expenses) ────────────────────────────

model TransactionCategory {
  id           String     @id @default(cuid())
  budgetYearId String
  budgetYear   BudgetYear @relation(fields: [budgetYearId], references: [id], onDelete: Cascade)
  name         String
  color        String     @default("#a78bfa")
  sortOrder    Int        @default(0)

  expenseCategoryId String?
  expenseCategory   BudgetExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)

  transactions Transaction[]

  @@unique([budgetYearId, name])
  @@index([budgetYearId])
}

model Transaction {
  id          String              @id @default(cuid())
  categoryId  String
  category    TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount      Float
  date        DateTime
  description String?
  createdAt   DateTime            @default(now())

  @@index([categoryId])
  @@index([date])
}

// ─── Roadmap ────────────────────────────────────────────────

model RoadmapPhase {
  id        String   @id @default(cuid())
  name      String
  emoji     String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([position])
}
